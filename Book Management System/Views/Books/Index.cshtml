@model IEnumerable<BookManagementSystem.Models.Book>

@{
    ViewData["Title"] = "Book Catalog";
}

<div class="container mt-4">
    <!-- Header Block with Export Action Feature -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="color: #4a3366;"><i class="bi bi-journal-bookmark-fill me-2"></i>Library Collection</h2>
        <div>
            <!-- NEW UPDATE 4: CSV File Download Integration Hook -->
            <a asp-action="ExportToCSV" class="btn btn-outline-secondary me-2 shadow-sm">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i>Export to CSV
            </a>
            <a asp-action="Create" class="btn btn-lilac shadow-sm">
                <i class="bi bi-plus-lg me-1"></i>Add New Book
            </a>
        </div>
    </div>

    <!-- UPDATE 1: Interactive Real-Time Search Bar Filter Block -->
    <div class="row mb-4">
        <div class="col-md-6">
            <form asp-action="Index" method="get" class="d-flex shadow-sm rounded">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="searchString" class="form-control border-start-0 ps-0" placeholder="Search books by title or author..." />
                    <button type="submit" class="btn btn-lilac">Search</button>
                </div>
            </form>
        </div>
    </div>

    <!-- UPDATE 3: Conditional Interface Layout for Empty States vs Data States -->
    @if (!Model.Any())
    {
        <div class="alert text-center p-5 shadow-sm rounded border-0" style="background-color: #f3effa; color: #513970;">
            <i class="bi bi-journal-x display-4 mb-3 d-block"></i>
            <h5>No Books Found</h5>
            <p class="text-muted">Your personal catalog is currently empty or no matches were found. Click "Add New Book" or clear your filter to begin building your collection.</p>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary mt-2">Clear Filters</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover shadow-sm rounded overflow-hidden align-middle">
                <thead class="lilac-header">
                    <tr>
                        <th>Title</th>
                        <th>Author</th>
                        <th>ISBN</th>
                        <th>Published Year</th>
                        <th>Genre</th>
                        <th class="text-center">System Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.Title</strong></td>
                            <td><span class="text-muted">@item.Author</span></td>
                            <td><code>@item.ISBN</code></td>
                            <td>@item.PublishedYear</td>
                            <td><span class="badge badge-lilac">@item.Genre</span></td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-lilac me-1 shadow-sm">
                                    <i class="bi bi-pencil-square me-1"></i>Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger shadow-sm">
                                    <i class="bi bi-trash3 me-1"></i>Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
